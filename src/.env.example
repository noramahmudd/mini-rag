APP_NAME="MINI-RAG"
APP_VERSION="0.1"

# Upload validation and streaming (size is in MB; chunk size is in bytes)
FILE_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# PostgreSQL metadata/chunk store
POSTGRES_USERNAME="minirag"
POSTGRES_PASSWORD="change-me"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="minirag"

# LLM and embedding providers
GENERATION_BACKEND="OLLAMA"
EMBEDDING_BACKEND="HUGGINGFACE"
OLLAMA_API_URL="http://localhost:11434"
GENERATION_MODEL_ID="qwen2.5:3b-instruct-q3_k_s"
EMBEDDING_MODEL_ID="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_SIZE=384
INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# Vector store
VECTOR_DB_BACKEND_LITERAL=["QDRANT","PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
QDRANT_DB_PATH="qdrant_db"
QDRANT_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THREADHOLD=100

# Prompt templates
PRIMARY_LANG="en"
DEFAULT_LANG="en"
